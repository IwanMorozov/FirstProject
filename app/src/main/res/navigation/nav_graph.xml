<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.firstproject.page.OnBoardingFragment"
        android:label="onBoarding"
        tools:layout="@layout/activity_onboarding">
        <action
            android:id="@+id/action_onboarding_to_main"
            app:destination="@+id/mainFragment" />
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.firstproject.page.MainFragment"
        android:label="Main"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_main_to_movieDetail"
            app:destination="@+id/movieDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/movieDetailFragment"
        android:name="com.example.firstproject.fragment.MovieDetailFragment"
        android:label="Movie Detail"
        tools:layout="@layout/activity_movie_detail">
        <argument
            android:name="movie_id"
            app:argType="string"/>
    </fragment>
</navigation>